[Unit]
Description=Stoperica API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=stoperica
WorkingDirectory=/srv/stoperica/api
EnvironmentFile=/etc/stoperica/api.env
ExecStart=/usr/bin/node --enable-source-maps --max-old-space-size=192 server.mjs
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
